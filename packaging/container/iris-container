#!/bin/sh
# Starts Iris from its container on this Wayland desktop, with Podman (or
# Docker when Podman is not there):
#   iris-container [address]
# IRIS_IMAGE picks the image (default ghcr.io/tulip-labs/iris-browser:latest).
#
# For speed it gives the container what a browser needs to run at full pace:
# the GPU (drawing and video decoding; NVIDIA through CDI when it is set up),
# a large shared memory (WebKit passes video frames through it), an init that
# reaps WebKit's processes, and a home volume that keeps the page cache
# and the GPU's shader cache between runs. Downloads land in your own
# Downloads folder, sound goes to PipeWire or PulseAudio.
set -e
image=${IRIS_IMAGE:-ghcr.io/tulip-labs/iris-browser:latest}
: "${XDG_RUNTIME_DIR:?needs a desktop session (XDG_RUNTIME_DIR)}"
: "${WAYLAND_DISPLAY:?needs a Wayland session (WAYLAND_DISPLAY)}"
case $WAYLAND_DISPLAY in
/*) wl=$WAYLAND_DISPLAY ;;
*) wl=$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY ;;
esac
downloads=$(xdg-user-dir DOWNLOAD 2>/dev/null || echo "$HOME/Downloads")
[ "$downloads" = "$HOME" ] && downloads=$HOME/Downloads
mkdir -p "$downloads"

if command -v podman >/dev/null 2>&1; then
	engine=podman
	# the same user inside as outside, so the shared sockets and Downloads work
	who="--userns=keep-id"
	home="iris-home:/home/iris:U"
elif command -v docker >/dev/null 2>&1; then
	engine=docker
	who="--user $(id -u):$(id -g) -e HOME=/home/iris"
	home="iris-home:/home/iris"
else
	echo "Podman or Docker is needed" >&2
	exit 1
fi

opts=""
add() { opts="$opts $*"; }
# the GPU: Mesa (Intel, AMD) through /dev/dri, NVIDIA through CDI
[ -d /dev/dri ] && add --device /dev/dri
if [ -e /dev/nvidiactl ] && [ "$engine" = podman ] && podman info --format '{{.Host.CDISpecDirs}}' >/dev/null 2>&1 &&
	ls /etc/cdi/nvidia*.yaml /var/run/cdi/nvidia*.yaml >/dev/null 2>&1; then
	add --device nvidia.com/gpu=all
fi
# sound: PipeWire's socket, else PulseAudio's
if [ -S "$XDG_RUNTIME_DIR/pipewire-0" ]; then
	add -v "$XDG_RUNTIME_DIR/pipewire-0:/run/host/pipewire-0" -e PIPEWIRE_REMOTE=/run/host/pipewire-0
fi
if [ -S "$XDG_RUNTIME_DIR/pulse/native" ]; then
	add -v "$XDG_RUNTIME_DIR/pulse/native:/run/host/pulse" -e PULSE_SERVER=unix:/run/host/pulse
fi
# the host's own choices, passed on when set
[ -n "$IRIS_NO_SANDBOX" ] && add -e IRIS_NO_SANDBOX
[ -n "$IRIS_SCALE" ] && add -e IRIS_SCALE
[ -n "$TZ" ] && add -e TZ

# shellcheck disable=SC2086 # $who and $opts are lists of options
exec "$engine" run --rm --init \
	$who \
	--security-opt label=disable \
	--shm-size=2g \
	-e WAYLAND_DISPLAY=/run/host/wayland \
	-e LANG="${LANG:-C.UTF-8}" \
	-v "$wl:/run/host/wayland" \
	-v /etc/localtime:/etc/localtime:ro \
	-v "$home" \
	-v "$downloads:/home/iris/Downloads" \
	$opts \
	"$image" "$@"
