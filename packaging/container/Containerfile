# Iris in a container, for Podman (or Docker). It shows on the host's Wayland
# display through the shared socket: run it with packaging/container/iris-podman
# (see README.md here). Flatpak stays the better way to install Iris; this is
# for systems where containers are the way programs arrive.
#
#   podman build -f packaging/container/Containerfile -t iris-browser .

# --- build: the program, Electron and Iris's helper (build-iris.sh linux)
FROM registry.fedoraproject.org/fedora:44 AS build
RUN dnf -y install --setopt=install_weak_deps=False \
      golang gcc pkgconf git zip nodejs npm \
      gtk4-devel libepoxy-devel webkitgtk6.0-devel \
      libxkbcommon-devel wayland-devel mesa-libEGL-devel vulkan-headers \
    && dnf clean all
WORKDIR /src
COPY . .
RUN ./build-iris.sh linux

# --- run: GTK 4, WebKitGTK 6 with its media and sandbox, what Electron loads
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install --setopt=install_weak_deps=False \
      gtk4 gtk3 webkitgtk6.0 glib-networking bubblewrap xdg-dbus-proxy \
      gstreamer1-plugins-base gstreamer1-plugins-good gstreamer1-plugins-bad-free \
      mesa-dri-drivers mesa-libEGL mesa-libgbm libdrm vulkan-loader \
      nss nspr alsa-lib cups-libs at-spi2-atk libxkbcommon libXcomposite \
      libXdamage libXrandr libXScrnSaver dbus-daemon dbus-tools \
      pipewire-pulseaudio-libs pulseaudio-libs \
      google-noto-sans-fonts google-noto-serif-fonts google-noto-emoji-fonts \
      adwaita-icon-theme ca-certificates \
    && dnf clean all
COPY --from=build /src/dist/linux /opt/iris
RUN ln -s /opt/iris/iris /usr/local/bin/iris \
    && install -Dm644 /opt/iris/io.github.tulip_labs.Iris.desktop /usr/share/applications/io.github.tulip_labs.Iris.desktop \
    && install -Dm644 /opt/iris/io.github.tulip_labs.Iris.png /usr/share/icons/hicolor/512x512/apps/io.github.tulip_labs.Iris.png \
    && printf '%s\n' '#!/bin/sh' \
      '# a private runtime folder (Iris keeps its line to Electron there) and a session bus' \
      'export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$(mktemp -d)}"' \
      'exec dbus-run-session -- iris "$@"' > /opt/iris/start \
    && chmod 755 /opt/iris/start \
    && useradd -m -u 1000 iris
LABEL org.opencontainers.image.title="Iris" \
      org.opencontainers.image.description="A light, fast browser in Go: WebKitGTK for most pages, Electron for the heavy ones" \
      org.opencontainers.image.source="https://github.com/Tulip-Labs/Iris-Browser" \
      org.opencontainers.image.licenses="GPL-3.0-only"
USER iris
ENV HOME=/home/iris GDK_BACKEND=wayland
WORKDIR /home/iris
ENTRYPOINT ["/opt/iris/start"]
