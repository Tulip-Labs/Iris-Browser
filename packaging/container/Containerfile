# Iris in a container, for Podman (or Docker). It draws on the host's Wayland
# display through the shared socket, with the GPU, and plays sound through
# PipeWire or PulseAudio: run it with packaging/container/iris-container
# (see README.md here).
#
#   podman build -f packaging/container/Containerfile -t iris-browser .

# --- build: the program (build-iris.sh linux)
FROM registry.fedoraproject.org/fedora:44 AS build
RUN dnf -y install --setopt=install_weak_deps=False \
      golang gcc pkgconf git \
      gtk4-devel libepoxy-devel freetype-devel webkitgtk6.0-devel \
      libxkbcommon-devel libxkbcommon-x11-devel libX11-devel libXcursor-devel libxcb-devel \
      wayland-devel mesa-libEGL-devel vulkan-headers \
    && dnf clean all
WORKDIR /src
COPY . .
RUN ./build-iris.sh linux

# --- run
FROM registry.fedoraproject.org/fedora:44
# GTK 4 and WebKitGTK 6 with its sandbox; the GPU (Mesa: OpenGL, Vulkan and
# VA-API video decoding, which GStreamer's va plugin uses); GStreamer for
# WebKit's video; fonts and sound
RUN dnf -y install --setopt=install_weak_deps=False \
      gtk4 webkitgtk6.0 glib-networking bubblewrap xdg-dbus-proxy \
      mesa-dri-drivers mesa-libEGL mesa-libgbm mesa-vulkan-drivers mesa-va-drivers \
      libdrm vulkan-loader libva \
      gstreamer1-plugins-base gstreamer1-plugins-good gstreamer1-plugins-bad-free \
      dbus-daemon dbus-tools \
      pipewire-libs pulseaudio-libs \
      google-noto-sans-fonts google-noto-serif-fonts google-noto-sans-mono-fonts google-noto-color-emoji-fonts \
      adwaita-icon-theme ca-certificates xdg-user-dirs glibc-langpack-en glibc-langpack-es \
    && dnf clean all
# H.264 and AAC for WebKit's video, where the repositories carry them
# (OpenH264 comes from Cisco's repository, which Fedora enables)
RUN dnf -y install --setopt=install_weak_deps=False --skip-unavailable \
      gstreamer1-plugin-libav gstreamer1-plugin-openh264 \
    && dnf clean all && rm -rf /var/cache/dnf /var/cache/libdnf5 /var/log/dnf*
# the font cache is built once here, not at every start
RUN fc-cache -f
COPY --from=build /src/dist/linux /opt/iris
COPY packaging/container/start /opt/iris/start
RUN chmod 755 /opt/iris/start \
    && ln -s /opt/iris/iris /usr/local/bin/iris \
    && install -Dm644 /opt/iris/io.github.tulip_labs.Iris.desktop /usr/share/applications/io.github.tulip_labs.Iris.desktop \
    && install -Dm644 /opt/iris/io.github.tulip_labs.Iris.png /usr/share/icons/hicolor/512x512/apps/io.github.tulip_labs.Iris.png \
    && useradd -m -u 1000 iris
LABEL org.opencontainers.image.title="Iris" \
      org.opencontainers.image.description="A light, fast browser in Go, with WebKitGTK" \
      org.opencontainers.image.source="https://github.com/Tulip-Labs/Iris-Browser" \
      org.opencontainers.image.licenses="GPL-3.0-only"
USER iris
ENV HOME=/home/iris GDK_BACKEND=wayland
WORKDIR /home/iris
ENTRYPOINT ["/opt/iris/start"]
