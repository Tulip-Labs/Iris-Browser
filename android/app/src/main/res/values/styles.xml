<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Lite draws its own bars; the system theme only sets the dialogs, the text cursor and the starting color -->
    <style name="Lite" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#923993</item>
        <item name="android:colorAccent">#923993</item>
        <item name="android:windowBackground">@color/start</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <color name="start">#FFF8EEF4</color>
</resources>
